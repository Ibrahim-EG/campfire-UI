name: Campfire Canvas Forge

# Triggers the build when you push code, or manually via the GitHub UI
on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch: # Crucial for tablet users: allows you to tap "Run workflow" manually in the Actions tab

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
      # Step 1: Fetch your living painting code
      - name: Checkout the Canvas
        uses: actions/checkout@v4

      # Step 2: Set up JDK 17 (Required for modern Jetpack Compose and Android Gradle Plugin)
      - name: Prepare the Forge (JDK 17)
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle # Caches dependencies to speed up future builds

      # Step 3: Ensure the Gradle wrapper has permission to execute
      - name: Grant Execution Rights to the Builder
        run: chmod +x gradlew

      # Step 4: Compile the code into a Debug APK (Safe Preview Mode)
      # We use Debug instead of Release so you don't need to configure cryptographic signing keys on your tablet
      - name: Mix the Pigments and Compile
        run: ./gradlew assembleDebug

      # Step 5: Package the APK so you can download it directly to your tablet
      - name: Deliver the Preview (Upload Artifact)
        uses: actions/upload-artifact@v4
        with:
          name: campfire-canvas-preview
          path: app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7 # Keeps the APK available for a week before GitHub deletes it to save space
