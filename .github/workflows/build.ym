name: Campfire Canvas Forge

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout the Canvas
        uses: actions/checkout@v4

      - name: Prepare the Forge (JDK 17)
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      # Summons Gradle itself onto the runner — no binary wrapper JAR needed in your repo
      - name: Summon Gradle 8.7 directly
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.7'

      - name: Mix the Pigments and Compile
        run: gradle assembleDebug --no-daemon

      - name: Deliver the Preview
        uses: actions/upload-artifact@v4
        with:
          name: campfire-canvas-preview
          path: app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7
